<p id="notice"><%= notice %></p>

<p>
  <strong>Happened at:</strong>
  <%= @classroom_register.happened_at %>
</p>

<p>
  <strong>Attendees:</strong>
  <%= @classroom_register.attendees %>
</p>

<p>
  <strong>Description:</strong>
  <%= @classroom_register.description %>
</p>

<p>
  <strong>Chapter:</strong>
  <%= @classroom_register.chapter.name %>
</p>

<p>
  <strong>Teacher:</strong>
  <%= @classroom_register.teacher.name %>
</p>

<p>
  <strong>Images:</strong>
</p>
<ul>
  <% @classroom_register.images.each do |file| %>
    <li>
      <%# Thumbnails are disabled. Generating a variant needs the image_processing
          gem, which is commented out of the Gemfile because Active Storage 8.1
          will not boot against this host's libvips 8.9.1 (it needs >= 8.13).
          Images are shown at full size instead.

          To restore thumbnails: install libvips >= 8.13, uncomment
          image_processing in the Gemfile, and swap the line below back to
            image_tag file.variant(resize_to_limit: [100, 100])
          See docs/upgrade-notes.md section 5. %>
      <%= image_tag url_for(file), style: "max-width: 100px; max-height: 100px;" %>
    </li>
  <% end %>
</ul>
<%# This condition was inverted: it rendered the player only when NO audio was
    attached, and rails_blob_url on an unattached attachment raises, so the page
    errored for every register without a recording. %>
<% if @classroom_register.audio.attached? %>
<p>
  <strong>Audio:</strong>
  <%= audio_tag(rails_blob_url(@classroom_register.audio), autoplay: false, controls: true) %>
</p>
<% end %>


<%= link_to 'Edit', edit_classroom_register_path(@classroom_register) %> |
<%= link_to 'Back', classroom_registers_path %>
